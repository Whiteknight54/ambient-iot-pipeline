{
  "region": "eu-west-2",
  "endpoint": "<ACCOUNT_PREFIX>-ats.iot.eu-west-2.amazonaws.com",
  "thing_name": "aiot-edge-gateway",
  "thing_arn": "arn:aws:iot:eu-west-2:<ACCOUNT_ID>:thing/aiot-edge-gateway",
  "certificate_arn": "arn:aws:iot:eu-west-2:<ACCOUNT_ID>:cert/<CERTIFICATE_ID>",
  "cert_file": "infra/certs/device.pem.crt",
  "key_file": "infra/certs/private.pem.key",
  "ca_file": "infra/certs/AmazonRootCA1.pem",
  "hot_lambda_arn": "arn:aws:lambda:eu-west-2:<ACCOUNT_ID>:function:aiot-hot-path",
  "cold_lambda_arn": "arn:aws:lambda:eu-west-2:<ACCOUNT_ID>:function:aiot-cold-path",
  "mqtt_topic": "aiot/telemetry",
  "mqtt_port": 8883,
  "s3_bucket": "aiot-cold-store-<ACCOUNT_ID>",
  "dynamodb_table": "aiot-telemetry"
}